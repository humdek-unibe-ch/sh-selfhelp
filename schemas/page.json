    "type": "object",
    "properties": {
        "page": {
            "$ref": "#/definitions/page"
        },
        "file_name": {
            "type": "string"
        },
        "time": {
            "type": "string"
        },
        "platform": {
            "type": "string"
        },
        "version": {
            "type": "object",
            "properties": {
                "application": {
                    "type": "string"
                },
                "database": {
                    "type": "string"
                }
            }
        }
    },
    "required": [
        "file_name",
        "time",
        "platform",
        "version",
        "page"
    ]

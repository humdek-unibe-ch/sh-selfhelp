{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "field": {
            "type": "object",
            "properties": {
                "id_styles": {
                    "type": "integer"
                },
                "style_name": {
                    "type": "string"
                },
                "field_name": {
                    "type": "string"
                },
                "id_fields": {
                    "type": "integer"
                },
                "locale": {
                    "type": "string"
                },
                "gender": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                }
            },
            "required": [
                "id_styles",
                "style_name",
                "field_name",
                "id_fields",
                "locale",
                "gender",
                "content"
            ]
        },
        "section": {
            "type": "object",
            "properties": {
                "id_sections": {
                    "type": "integer"
                },
                "section_name": {
                    "type": "string"
                },
                "id_styles": {
                    "type": "integer"
                },
                "style_name": {
                    "type": "string"
                },
                "position": {
                    "type": "integer"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/field"
                    }
                },
                "children": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/section"
                    }
                },
                "nav_children": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/section"
                    }
                }
            },
            "required": [
                "id_sections",
                "section_name",
                "position",
                "fields"
            ]
        },
        "page_field": {
            "type": "object",
            "properties": {
                "field_name": {
                    "type": "string"
                },
                "locale": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                }
            },
            "required": [
                "field_name",
                "locale",
                "content"
            ]
        },
        "page": {
            "type": "object",
            "properties": {
                "keyword": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                },
                "protocol": {
                    "type": "string"
                },
                "action": {
                    "type": "string"
                },
                "page_type": {
                    "type": "string"
                },
                "page_access_type": {
                    "type": "string"
